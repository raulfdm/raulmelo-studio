---
type Props = {
  node: {
    caption: string;
    src: string;
    width?: number;
    height?: number;
  };
};
const { caption, src, width = 300, height } = Astro.props.node;

/**
 * Deliberately a plain `<img>` rather than `astro:assets`. These GIFs are
 * hosted on third party services (Giphy, GitHub camo), so optimising them at
 * build time both re-encodes something already optimised and lets a single
 * rotten URL fail the entire build.
 */
---

<figure
  class="relative mx-auto flex flex-col"
  style={{
    maxWidth: width ? `${width}px` : `fit-content`,
  }}
>
  <img
    alt={caption ?? ``}
    width={width}
    height={height ?? width}
    src={src}
    loading="lazy"
    decoding="async"
  />
  {caption && <figcaption class="text-center w-full">{caption}</figcaption>}
</figure>
